# رابط مشروع Supabase (Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح service_role السرّي (Settings → API → service_role secret)
# لا يُستخدم أبداً في كود المتصفح — فقط بالخادم (Server Actions).
SUPABASE_SERVICE_ROLE_KEY=

# كلمة مرور تسجيل الدخول للتطبيق (نص عادي تكتبه أنت هنا فقط، لا يظهر للمستخدم)
APP_PASSWORD=

# سر عشوائي طويل لتوقيع جلسة الدخول — ولّده بالأمر:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
